# Provider: openai or azure (defaults to openai when omitted)
LLM_PROVIDER=openai

# Required for both providers: a number from 0 to 2
LLM_TEMPERATURE=0.7

# OpenAI: used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Azure OpenAI: used when LLM_PROVIDER=azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_OPENAI_TOKEN_SCOPE=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Optional corporate proxy settings
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Application settings
DATABASE_PATH=main_datawarehouse.db
MAX_QUESTION_LENGTH=500
MAX_RESULT_ROWS=100
